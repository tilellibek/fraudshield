# En local, laissez DATABASE_URL vide pour utiliser data/fraudshield.db.
# Sur Render, collez l'Internal Database URL de PostgreSQL.
DATABASE_URL=

FRAUDSHIELD_USER=admin
FRAUDSHIELD_PASSWORD=remplacez-par-un-mot-de-passe-de-12-caracteres

# À renseigner après le déploiement du frontend.
FRONTEND_URL=
ENVIRONMENT=development
